msgid "Save the record."
msgstr "レコードを保存します。"

#. module: mail_gateway_line
#: model_terms:ir.ui.view,arch_db:mail_gateway_line.mail_gateway_form_view
msgid ""
"Set a random value of your choice in the\n"
"                                <b>Webhook Key</b> field. It is the part of the\n"
"                                webhook URL that identifies this gateway."
msgstr ""
"<b>Webhook Key</b> 欄に任意のランダムな値を\n"
"                                設定します。この値が Webhook URL の\n"
"                                このゲートウェイを識別する部分になります。"

#. module: mail_gateway_line
#. odoo-python
